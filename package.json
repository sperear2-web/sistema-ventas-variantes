{
  "name": "sistema-ventas-variantes",
  "version": "1.1.0",
  "description": "Sistema de ventas con variantes Básica y Premium sobre una base de código común (Componente Práctico 2 - GCS, UNEMI)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:basica": "cross-env VARIANT=basica node src/server.js",
    "start:premium": "cross-env VARIANT=premium node src/server.js",
    "build": "node scripts/build.js",
    "validate-config": "node scripts/validate-config.js",
    "test": "jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
